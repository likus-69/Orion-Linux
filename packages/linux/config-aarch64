#
# packages/linux/config-aarch64
#
# Default kernel config for Orion Linux on aarch64.
# Targets generic ARMv8 hardware + Ampere VMs + Raspberry Pi 4/5
# (when paired with the bcm2712 defconfig from /lib/firmware/raspberrypi).
#

CONFIG_64BIT=y
CONFIG_ARM64=y
CONFIG_LOCALVERSION="-orion-aarch64"
CONFIG_DEFAULT_HOSTNAME="orion"

CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_BPF_SYSCALL=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y

# --- Init + early userspace ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# --- EFI (most aarch64 boards + VMs) ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- Storage ---
CONFIG_BLK_DEV_LOOP=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_SCSI=y
CONFIG_SCSI_VIRTIO=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_MMC_BCM2835=y

# --- Filesystems ---
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_F2FS_FS=y
CONFIG_BTRFS_FS=y
CONFIG_XFS_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_ISO9660_FS=y
CONFIG_UDF_FS=y

# --- Networking ---
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_BRCMFMAC=y
CONFIG_RTL_CARDS=y
CONFIG_RTL8723BE=y
CONFIG_RTL8821AE=y
CONFIG_ATH9K=y
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y

# --- Sound ---
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_SOC=y
CONFIG_SND_BCM2835_SOC_I2S=y

# --- USB ---
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_HID=y

# --- DRM / display ---
CONFIG_DRM=y
CONFIG_DRM_NOUVEAU=y
CONFIG_DRM_VKMS=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_PANEL_BRIDGE=y
CONFIG_DRM_PANEL_ORIENTATION_QUIRKS=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- Input + touch ---
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y

# --- Crypto (no AES-NI on most ARM cores) ---
CONFIG_CRYPTO=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_ARM64_AES=y
CONFIG_CRYPTO_ARM64_SHA2=y
CONFIG_CRYPTO_USER_API=y

# --- SBCs ---
CONFIG_ARCH_BCM2835=y
CONFIG_ARCH_BCM2711=y
CONFIG_ARCH_BCM2712=y
CONFIG_BCM2835_WDT=y
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_RASPBERRYPI_POWER=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCIEPORTBUS=y

# --- Power ---
CONFIG_THERMAL=y
CONFIG_CPU_THERMAL=y
CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# --- Other ---
CONFIG_MAGIC_SYSRQ=y
CONFIG_PRINTK_TIME=y
