# images/Dockerfile.aarch64
#
# Build container for Orion Linux on aarch64.
#
# This image is built on aarch64 hardware (or under QEMU emulation via
# `docker buildx build --platform linux/arm64` from an x86_64 host). The
# commands inside are identical to the x86_64 build; only the platform
# flag changes.
#
# QEMU user-mode emulation must be registered on the host via:
#
#   docker run --rm --privileged multiarch/qemu-user-static --reset -p yes
#
# This is done by the GitHub Actions workflow (see .github/workflows/build-aarch64.yml).

FROM --platform=linux/arm64 debian:12-slim AS base

RUN apt-get update -qq \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      bash ca-certificates curl xz-utils gzip bzip2 tar \
      bison flex texinfo gperf gettext \
      g++ gcc make patch pkg-config \
      libgmp-dev libmpfr-dev libmpc-dev libisl-dev \
      libelf-dev libssl-dev zlib1g-dev libzstd-dev \
      libpcre2-dev libexpat1-dev libffi-dev libnl-3-dev libnl-route-3-dev \
      libcap-dev libattr1-dev libacl1-dev libseccomp-dev \
      libblkid-dev libmount-dev libuuid1 uuid-dev \
      kmod systemd-container dracut \
      xorriso mtools dosfstools squashfs-tools \
      fakeroot \
      bc docbook-xml docbook-xsl \
      python3 python3-jinja2 python3-pip \
      perl \
      vim less \
      git \
      qemu-utils \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/orion
COPY . /usr/src/orion/

ARG ARCH=aarch64
ARG VERSION=dev
ENV ORION_ARCH=$ARCH
ENV ORION_VERSION=$VERSION
ENV DEBIAN_FRONTEND=noninteractive
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

RUN mkdir -p /out /mnt/orion /var/orion/installed /var/orion/cache /var/orion/sources

RUN bash -ex /usr/src/orion/scripts/00-host-prepare.sh || echo "stage 00 had issues; continuing"
RUN bash -ex /usr/src/orion/scripts/01-build-cross-toolchain.sh
RUN bash -ex /usr/src/orion/scripts/02-build-temp-tools.sh
RUN bash -ex /usr/src/orion/scripts/03-build-lfs-system.sh
RUN bash -ex /usr/src/orion/scripts/04-config-system.sh
RUN bash -ex /usr/src/orion/scripts/05-build-kernel.sh
RUN bash -ex /usr/src/orion/scripts/06-build-bootloader.sh
RUN bash -ex /usr/src/orion/scripts/07-make-image.sh \
        $ARCH $VERSION /out /mnt/orion

FROM scratch
COPY --from=base /out/ /out/
ENTRYPOINT ["echo", "Orion Linux aarch64 build container; see /out/"]
