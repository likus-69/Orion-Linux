# images/Dockerfile.bootstrap
#
# v0.1 fast-path build image.
#
# Uses debootstrap to create a minimal Debian 12 rootfs at /mnt/orion,
# then layers Orion branding + tools + mainline kernel + GRUB + ISO.
#
# Much lighter than the LFS-from-scratch Dockerfile.x86_64: only ~10 deps
# vs ~40+. Build time: ~20 min (vs 6-10 hours for LFS).

FROM --platform=linux/${TARGETARCH:-amd64} debian:12-slim AS base

RUN apt-get update -qq \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      bash ca-certificates curl xz-utils gzip tar \
      debootstrap debian-archive-keyring \
      qemu-user-static \
      squashfs-tools xorriso mtools dosfstools \
      bc \
      perl python3 python3-jinja2 \
      git \
      gcc make \
      libelf-dev libssl-dev zlib1g-dev libzstd-dev \
      flex bison \
      fakeroot \
      grub-common grub-pc-bin grub-efi-amd64-bin \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/orion
COPY . /usr/src/orion/

ARG ARCH=x86_64
ARG VERSION=dev
ARG TARGETARCH=amd64
ENV ORION_ARCH=$ARCH
ENV ORION_VERSION=$VERSION
ENV DEBIAN_FRONTEND=noninteractive
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

RUN mkdir -p /out /mnt/orion /var/orion/installed /var/orion/cache /var/orion/sources

# Phase 1: bootstrap the rootfs (replaces LFS stages 00-03)
RUN bash -ex /usr/src/orion/scripts/bootstrap-debootstrap.sh

# Phase 2: configure the system (uses existing stage 04, lightly adapted)
RUN bash -ex /usr/src/orion/scripts/04-config-system.sh || \
    echo "stage 04 partially applied — continuing"

# Phase 3: build the kernel from source (we don't trust Debian's kernel
# for our v0.1 because we want a consistent /boot)
RUN bash -ex /usr/src/orion/scripts/05-build-kernel.sh

# Phase 4: install bootloader binaries (GRUB into /usr/lib/grub/)
# We do NOT run grub-install here — that needs a real block device.
# The installer does that at install time.
RUN bash -ex /usr/src/orion/scripts/06-build-bootloader.sh || \
    echo "stage 06 partially applied — continuing"

# Phase 5: package into rootfs tarball + squashfs + ISO
RUN bash -ex /usr/src/orion/scripts/07-make-image.sh \
        $ARCH $VERSION /out /mnt/orion

# Output only the artifacts
FROM scratch
COPY --from=base /out/ /out/
ENTRYPOINT ["echo", "Orion Linux bootstrap build; see /out/"]
